// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    user_id             String      @id @default(uuid())
    created_at          DateTime    @default(now())
    name                String
    email               String      @unique
    password_hash       String
    points              Int         @default(0)
    body                Int?
    face                Int?
    skin_top            Int?
    skin_bottom         Int?
    shoes               Int?
    hair                Int?
    accessory           Int?
    hand_accessory      Int?
    item_body           Item?       @relation("UserBody", fields: [body], references: [item_id])
    item_face           Item?       @relation("UserFace", fields: [face], references: [item_id])
    item_skin_top       Item?       @relation("UserSkinTop", fields: [skin_top], references: [item_id])
    item_skin_bottom    Item?       @relation("UserSkinBottom", fields: [skin_bottom], references: [item_id])
    item_shoes          Item?       @relation("UserShoes", fields: [shoes], references: [item_id])
    item_hair           Item?       @relation("UserHair", fields: [hair], references: [item_id])
    item_accessory      Item?       @relation("UserAccessory", fields: [accessory], references: [item_id])
    item_hand_accessory Item?       @relation("UserHandAccessory", fields: [hand_accessory], references: [item_id])
    study_plans         StudyPlan[]
    Inventory           Inventory[]

    @@map("users")
}

enum Status {
    Completed
    Canceled
    Waiting
    InProgress
    Overdue
}

model StudyPlan {
    study_plan_id   Int      @id @default(autoincrement())
    subject         String
    status          Status   @default(Waiting)
    start_date      DateTime
    end_date        DateTime
    week_days       Int[]
    minutes_per_day Int
    total_minutes   Int
    user_id         String

    user    User      @relation(fields: [user_id], references: [user_id])
    Content Content[]
}

model Content {
    content_id        Int    @id @default(autoincrement())
    subject           String
    status            Status @default(Waiting)
    allocated_minutes Int
    studied_minutes   Int    @default(0)
    study_plan_id     Int

    study_plan     StudyPlan      @relation(fields: [study_plan_id], references: [study_plan_id])
    study_plan_day StudyPlanDay[]
}

model StudyPlanDay {
    study_plan_day_id Int      @id @default(autoincrement())
    date              DateTime
    status            Status   @default(Waiting)
    description       String   @default("")
    allocated_minutes Int
    studied_minutes   Int      @default(0)
    content_id        Int

    content Content @relation(fields: [content_id], references: [content_id])
}

enum Slot {
    Body
    Face
    SkinTop
    SkinBottom
    SkinTopAndBottom
    Shoes
    Hair
    Accessory
    HandAccessory
}

model Item {
    item_id              Int         @id @default(autoincrement())
    name                 String
    description          String
    price                Int
    slot                 Slot
    image_url            String
    users_body           User[]      @relation("UserBody")
    users_face           User[]      @relation("UserFace")
    users_skin_top       User[]      @relation("UserSkinTop")
    users_skin_bottom    User[]      @relation("UserSkinBottom")
    users_shoes          User[]      @relation("UserShoes")
    users_hair           User[]      @relation("UserHair")
    users_accessory      User[]      @relation("UserAccessory")
    users_hand_accessory User[]      @relation("UserHandAccessory")
    Inventory            Inventory[]

    @@map("items")
}

model Inventory {
    inventory_id Int    @id @default(autoincrement())
    user_id      String
    item_id      Int

    user User @relation(fields: [user_id], references: [user_id])
    item Item @relation(fields: [item_id], references: [item_id])
}
